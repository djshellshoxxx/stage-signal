# Helpers so every core module and its tests are discovered automatically. Workers add files
# under core/<module>/ and tests/unit/<module>/ and never touch the root CMakeLists.txt.

# ss_add_module(<name> [HEADER_ONLY] [DEPS mod...] [SOURCES f...])
#   Layout: core/<name>/include/ss/<name>/*.hpp, core/<name>/src/*.cpp (globbed unless SOURCES given)
function(ss_add_module name)
  cmake_parse_arguments(M "HEADER_ONLY" "" "DEPS;SOURCES" ${ARGN})
  set(dir ${CMAKE_CURRENT_SOURCE_DIR})
  if(M_HEADER_ONLY)
    add_library(ss_${name} INTERFACE)
    target_include_directories(ss_${name} INTERFACE ${dir}/include)
    foreach(d ${M_DEPS})
      target_link_libraries(ss_${name} INTERFACE ss_${d})
    endforeach()
  else()
    if(M_SOURCES)
      set(srcs ${M_SOURCES})
    else()
      file(GLOB_RECURSE srcs CONFIGURE_DEPENDS ${dir}/src/*.cpp)
    endif()
    add_library(ss_${name} STATIC ${srcs})
    target_include_directories(ss_${name} PUBLIC ${dir}/include)
    target_compile_features(ss_${name} PUBLIC cxx_std_17)
    foreach(d ${M_DEPS})
      target_link_libraries(ss_${name} PUBLIC ss_${d})
    endforeach()
    ss_apply_warnings(ss_${name})
  endif()
  add_library(ss::${name} ALIAS ss_${name})
endfunction()

function(ss_apply_warnings target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wshadow -Wno-unused-parameter)
  endif()
endfunction()

# ss_add_test(<module> [DEPS mod...])  ->  executable test_<module> registered with CTest.
#   Sources: every *.cpp in the calling directory. A doctest main is provided by ss_test_main.
function(ss_add_test name)
  cmake_parse_arguments(T "" "" "DEPS" ${ARGN})
  file(GLOB srcs CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/*.cpp)
  add_executable(test_${name} ${srcs} ${SS_TEST_MAIN})
  target_include_directories(test_${name} PRIVATE ${SS_ROOT}/third_party)
  target_link_libraries(test_${name} PRIVATE ss_base)
  foreach(d ${T_DEPS})
    target_link_libraries(test_${name} PRIVATE ss_${d})
  endforeach()
  target_compile_features(test_${name} PRIVATE cxx_std_17)
  ss_apply_warnings(test_${name})
  add_test(NAME ${name} COMMAND test_${name})
endfunction()
