// Resources: icon, manifest (comctl32 v6, asInvoker, system-DPI aware), version info, offline help text, license notices.
#include <windows.h>
#include "app/version.h"

1 ICON "res/app.ico"
1 RT_MANIFEST "res/stagesignal.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SS_VERSION_RC
 PRODUCTVERSION SS_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Circuit Drift Labs"
      VALUE "FileDescription", "StageSignal operator application"
      VALUE "FileVersion", SS_VERSION
      VALUE "InternalName", "StageSignal"
      VALUE "LegalCopyright", "Copyright (c) 2026 Circuit Drift Labs"
      VALUE "OriginalFilename", "StageSignal.exe"
      VALUE "ProductName", "StageSignal"
      VALUE "ProductVersion", SS_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

HELP_00_WALKTHROUGH RCDATA "docs/help/00-first-show-walkthrough.md"
HELP_01_DISPLAYS RCDATA "docs/help/01-display-roles.md"
HELP_02_AUDIO RCDATA "docs/help/02-audio-gain-staging.md"
