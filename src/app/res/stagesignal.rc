HELP_11_BROADCAST RCDATA "docs/help/11-broadcast-protocols.md"
HELP_12_EXPORT RCDATA "docs/help/12-portable-export.md"
HELP_13_KEYS RCDATA "docs/help/13-keyboard-map.md"
HELP_14_DIAG RCDATA "docs/help/14-sanitized-diagnostics.md"
HELP_20_TS_AUDIO RCDATA "docs/help/20-troubleshoot-audio.md"
HELP_21_TS_DISPLAY RCDATA "docs/help/21-troubleshoot-displays.md"
HELP_22_TS_CAMERA RCDATA "docs/help/22-troubleshoot-camera.md"
